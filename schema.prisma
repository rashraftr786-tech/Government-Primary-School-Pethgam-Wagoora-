generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOI_ADMIN
  TEACHER
  SCHOOL_AAYA
  SCHOOL_COOK
}

model SchoolProfile {
  id        String         @id @default(cuid())
  name      String         @default("Government Primary School Pethgam Wagoora")
  udiseCode String         @unique @default("01022202207")
  address   String         @default("Wagoora Babareshi Road, Near Zonal Education Office Wagoora 193109")
  email     String         @default("pspethgam@gmail.com")
  contact   String         @default("9596449881")
  users     User[]
  students  Student[]
  mdmStock  MDMInventory[]
  mealLogs  MealLog[]
}

model User {
  id          String            @id @default(cuid())
  name        String
  role        Role
  email       String?           @unique
  phone       String?
  schoolId    String?
  school      SchoolProfile?    @relation(fields: [schoolId], references: [id])
  attendances Attendance[]      @relation("MarkedByRelation")
  staffLogs   StaffAttendance[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Student {
  id             String       @id @default(cuid())
  rollNo         Int
  name           String
  classLevel     Int
  gender         String
  category       String?
  bplStatus      Boolean      @default(false)
  aadhaarApaarId String?
  parentName     String?
  contactNumber  String?
  cwsnStatus     Boolean      @default(false)
  schoolId       String?
  school         SchoolProfile? @relation(fields: [schoolId], references: [id])
  attendances    Attendance[]
  grades         Grade[]
  schemes        Scheme[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([classLevel, rollNo])
}

model Attendance {
  id         String   @id @default(cuid())
  date       DateTime
  present    Boolean  @default(true)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedById String?
  markedBy   User?    @relation("MarkedByRelation", fields: [markedById], references: [id])
  createdAt  DateTime @default(now())
}

model StaffAttendance {
  id        String   @id @default(cuid())
  date      DateTime
  present   Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model MDMInventory {
  id          String        @id @default(cuid())
  item        String
  quantityKg  Float
  lastUpdated DateTime      @updatedAt
  schoolId    String?
  school      SchoolProfile? @relation(fields: [schoolId], references: [id])
}

model MealLog {
  id           String        @id @default(cuid())
  date         DateTime      @default(now())
  studentsFed  Int
  riceUsedKg   Float
  pulsesUsedKg Float
  oilUsedLtr   Float
  schoolId     String?
  school       SchoolProfile? @relation(fields: [schoolId], references: [id])
}

model Grade {
  id        String  @id @default(cuid())
  subject   String
  term      String
  marks     Float
  maxMarks  Float   @default(100)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Scheme {
  id         String    @id @default(cuid())
  schemeName String
  disbursed  Boolean   @default(false)
  date       DateTime?
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
