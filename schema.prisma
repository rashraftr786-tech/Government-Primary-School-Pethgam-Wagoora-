generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  HOI_ADMIN
  TEACHER
  SCHOOL_AAYA
  SCHOOL_COOK
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  GENERAL
  ST
  SC
  OBC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

enum SchemeType {
  FREE_TEXTBOOK
  FREE_UNIFORM
  DBT_SCHOLARSHIP
}

enum GradeType {
  FA
  SA
}

enum StockItem {
  RICE
  PULSES
  OIL
}

model SchoolProfile {
  id             String    @id @default(cuid())
  name           String
  address        String
  udiseCode      String    @unique
  contactEmail   String
  contactPhone   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  users          User[]
  students       Student[]
  mdmInventory   MDMInventory[]
  mealLogs       MealLog[]
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String?   @unique
  phone          String?
  role           RoleCode
  active         Boolean   @default(true)
  schoolId       String
  school         SchoolProfile @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  attendance     Attendance[]
  grades         Grade[]
  mealLogs       MealLog[]
  auditLogs      AuditLog[]
}

model Student {
  id             String    @id @default(cuid())
  schoolId       String
  school         SchoolProfile @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rollNo         String
  studentName    String
  classNo        Int
  gender         Gender?
  category       Category?
  bplStatus      Boolean   @default(false)
  aadhaarApaarId String?
  parentName     String?
  contactNumber  String?
  cwsnStatus     Boolean   @default(false)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  attendance     Attendance[]
  grades         Grade[]
  schemes        SchemeDistribution[]

  @@unique([schoolId, classNo, rollNo])
  @@index([schoolId, classNo])
}

model Attendance {
  id          String           @id @default(cuid())
  schoolId   String
  studentId  String?
  userId     String?
  date        DateTime
  status      AttendanceStatus
  markedById String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school     SchoolProfile @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  markedBy   User?    @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  note       String?
  createdAt  DateTime @default(now())

  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
}

model MDMInventory {
  id          String    @id @default(cuid())
  schoolId    String
  item        StockItem
  openingQty  Float     @default(0)
  incomingQty Float     @default(0)
  consumedQty Float     @default(0)
  closingQty  Float     @default(0)
  unit        String    @default("kg")
  threshold   Float     @default(5)
  date        DateTime
  school      SchoolProfile @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, item, date])
}

model MealLog {
  id             String   @id @default(cuid())
  schoolId       String
  date           DateTime
  attendanceHeadcount Int
  mealsCooked    Int
  riceGrams      Float
  pulsesGrams    Float
  oilGrams       Float
  notes          String?
  recordedById   String
  school         SchoolProfile @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy     User @relation(fields: [recordedById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([schoolId, date])
}

model Grade {
  id         String    @id @default(cuid())
  schoolId   String
  studentId  String
  subject    String
  gradeType  GradeType
  assessment String
  marks      Float
  maxMarks   Float
  term       String?
  enteredById String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy  User @relation(fields: [enteredById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SchemeDistribution {
  id        String     @id @default(cuid())
  schoolId  String
  studentId String
  scheme    SchemeType
  status    String
  academicYear String
  note      String?
  updatedAt DateTime @updatedAt
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheme, academicYear])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    SchoolProfile @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}
