rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── USERS ──────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile
      // Admin can read all profiles
      // Students/Teachers can read others for leaderboards
      allow read: if isAuth();

      // Users can create their own profile during signup
      allow create: if isOwner(userId);

      // Users can update their own profile
      // Admin can update any profile
      allow update: if isOwner(userId) || isAdmin();

      // Only admin can delete users
      allow delete: if isAdmin();
    }

    // ─── ASSIGNMENTS ────────────────────────────────────
    match /assignments/{assignmentId} {
      // All authenticated users can read assignments
      allow read: if isAuth();

      // Only teachers and admin can create
      allow create: if isTeacher() || isAdmin();

      // Only the teacher who created it or admin can update/delete
      allow update, delete: if isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // ─── ATTEMPTS ───────────────────────────────────────
    match /attempts/{attemptId} {
      // Students can read their own attempts
      // Teachers can read attempts for their questions
      // Admin can read all
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid);

      // Only students can create attempts (for themselves)
      allow create: if isStudent() &&
        request.resource.data.studentId == request.auth.uid;

      // No one can update or delete attempts
      allow update, delete: if false;
    }
  }
}
